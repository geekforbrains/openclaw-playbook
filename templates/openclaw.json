{
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token", "token": "${OPENCLAW_GATEWAY_TOKEN}" }
  },

  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-opus-4-6",
        "fallbacks": ["openai/gpt-5.4"]
      },
      "maxConcurrent": 1,
      "thinkingDefault": "adaptive",
      "compaction": { "mode": "safeguard" },
      "heartbeat": { "every": "0m" },
      "skipBootstrap": true
    },
    "list": [
      {
        "id": "ADMIN_ID",
        "workspace": "ADMIN_WORKSPACE",
        "agentDir": "ADMIN_DIR",
        "identity": { "name": "ADMIN_DISPLAY_NAME", "emoji": "🛡️" },
        "tools": {
          "profile": "full",
          "allow": [],
          "deny": [],
          "fs": { "workspaceOnly": false },
          "exec": { "security": "full" },
          "elevated": { "enabled": true }
        }
      },
      {
        "id": "researcher",
        "workspace": "RESEARCHER_WORKSPACE",
        "agentDir": "RESEARCHER_DIR",
        "identity": { "name": "Researcher", "emoji": "🔍" },
        "tools": {
          "allow": ["web_search", "web_fetch", "read", "write", "message", "cron"],
          "deny": ["exec", "group:automation", "group:runtime", "sessions_spawn", "gateway"],
          "fs": { "workspaceOnly": true }
        }
      }
    ]
  },

  "tools": {
    "profile": "messaging",
    "allow": [],
    "deny": ["*"],
    "fs": { "workspaceOnly": true },
    "exec": { "security": "deny" },
    "elevated": { "enabled": false }
  },

  "channels": {
    "slack": {
      "mode": "socket",
      "webhookPath": "/slack/events",
      "enabled": true,
      "userTokenReadOnly": true,
      "groupPolicy": "open",
      "dmPolicy": "allowlist",
      "allowFrom": ["SLACK_USER_ID"],
      "dm": { "enabled": true },
      "nativeStreaming": true,
      "streaming": "partial",
      "replyToMode": "first",
      "typingReaction": "eyes",
      "requireMention": true,
      "requireMentionInThreads": true,
      "accounts": {
        "ADMIN_ID": {
          "botToken": "${SLACK_BOT_TOKEN_ADMIN}",
          "appToken": "${SLACK_APP_TOKEN_ADMIN}"
        },
        "researcher": {
          "botToken": "${SLACK_BOT_TOKEN_RESEARCHER}",
          "appToken": "${SLACK_APP_TOKEN_RESEARCHER}"
        }
      },
      "defaultAccount": "ADMIN_ID"
    }
  },

  "bindings": [
    { "agentId": "ADMIN_ID", "match": { "channel": "slack", "accountId": "ADMIN_ID" } },
    { "agentId": "researcher", "match": { "channel": "slack", "accountId": "researcher" } }
  ],

  "skills": {
    "entries": {}
  }
}
